# sdist contents — ensure source distributions carry everything needed to
# reproduce the build, run the test suite (self-contained, no external
# checkout), and verify artifacts. Wheel data (.npz/.json) is handled by
# [tool.setuptools.package-data] in pyproject.toml; this file governs the
# sdist tarball only.

# License + metadata
include LICENSE
include CITATION.cff
include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include pyproject.toml
include requirements-jax.txt
include requirements-gpu.txt

# Maintainer and historical design documentation, including the immutable raw
# benchmark evidence linked by the packaged historical guide.
recursive-include docs *.md
include docs/benchmarks/historical/jax-0.4.30-eager-results.json
include docs/benchmarks/historical/jax-0.4.30-optimized-pytorch.txt

# Release tooling + artifact verifier
recursive-include scripts *.py

# Tests + shared utils + golden/frontend fixtures (self-contained CI gate).
# The frontend fixture stores compressed binary data as base64 text so it can
# be reviewed and transported without special binary-patch handling.
recursive-include tests *.py *.json *.npz *.b64

# Bundled weight artifacts (in-package data; also included as package-data
# in the wheel, but the sdist must carry them for editable/source installs).
recursive-include nisqa_jax/weights *.npz *.json LICENSE_model_weights CHECKSUMS.sha256

# Exclude build artifacts / caches from the sdist.
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .pytest_cache
global-exclude .mypy_cache
global-exclude .ruff_cache
# Prune any egg-info directories entirely (metadata dirs setuptools may leave
# in the source tree during local builds). `global-exclude *.egg-info` only
# excludes individual files whose path matches the pattern; `prune` removes
# whole directory trees, so no egg-info contents (SOURCES.txt, PKG-INFO, etc.)
# can leak into the sdist.
prune *.egg-info
